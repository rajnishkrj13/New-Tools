# Copy to .env.local (development) or set these on your server.

# Your Postgres database. Leave unset in development to use the built-in PGlite database
# (stored in ./.data/pglite). Example: postgres://toolyverse:password@localhost:5432/toolyverse
DATABASE_URL=

# The public address of the site, used in canonical links, the sitemap and share images.
NEXT_PUBLIC_SITE_URL=https://toolyverse.com

# Shown on the Contact page.
NEXT_PUBLIC_CONTACT_EMAIL=

# Search engine ownership tags (the code shown by Google Search Console / Bing Webmaster Tools).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# The brand's social profiles, comma-separated, e.g. https://x.com/toolyverse,https://www.linkedin.com/company/toolyverse
NEXT_PUBLIC_SITE_SAME_AS=
